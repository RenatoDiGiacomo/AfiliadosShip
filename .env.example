# URL pública do site (sitemap, canonical, Open Graph)
SITE_URL=http://localhost:3000

# Mercado padrão em dev local (sem header de país): br | us
DEFAULT_MARKET=br

# Afiliados US
AMAZON_TAG=
EBAY_CAMPID=

# off = não extrair imagens dos links dos produtos (use só image/images manuais)
IMAGE_SCRAPING=on

# Código de verificação do Google Search Console (meta tag)
GOOGLE_SITE_VERIFICATION=

# Código de reivindicação do site no Pinterest (meta tag p:domain_verify)
PINTEREST_SITE_VERIFICATION=

# Shopee API de afiliados (coloque em .env.local, nunca no GitHub)
SHOPEE_APP_ID=
SHOPEE_SECRET=

# Seu código numérico de afiliado Shopee (o número depois de an_ nos seus links, ex.: mmp_pid=an_123 -> 123)
SHOPEE_AFFILIATE_ID=
